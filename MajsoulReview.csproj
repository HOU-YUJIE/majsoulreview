<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MajsoulReview.ico</ApplicationIcon>
    <AssemblyName>MajsoulReview</AssemblyName>
    <RootNamespace>MajsoulReview</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>雀魂错题集</AssemblyTitle>
    <Product>雀魂错题集</Product>
    <Company>Maru</Company>
    <Authors>Maru</Authors>
    <Description>用于牌局结束后截图整理与复习的非官方雀魂错题集工具</Description>
    <Copyright>Copyright © 2026 Maru</Copyright>
    <RepositoryUrl>https://github.com/HOU-YUJIE/majsoulreview</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MajsoulReview.ico" />
  </ItemGroup>

</Project>
