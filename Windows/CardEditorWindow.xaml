<Window x:Class="MajsoulReview.Windows.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑错题"
        Icon="/MajsoulReview;component/Assets/MajsoulReview.ico"
        Width="1040" Height="720"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="确认这道错题" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           Text="左侧为错误一打，右侧为正确一打。" />
            </StackPanel>
            <Button Content="交换两张图"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Swap_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#101615" BorderBrush="#DCE2DF" BorderThickness="1">
                <Grid>
                    <Image x:Name="QuestionImage" Stretch="Uniform" Margin="8" />
                    <Border Background="#D9A52B" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,5">
                        <TextBlock Text="错误一打" Foreground="#1D2528" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="#101615" BorderBrush="#DCE2DF" BorderThickness="1">
                <Grid>
                    <Image x:Name="AnswerImage" Stretch="Uniform" Margin="8" />
                    <Border Background="#147D64" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="10,5">
                        <TextBlock Text="正确一打" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="分类" Margin="0,0,0,6" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CategoryBox"
                              IsEditable="True"
                              IsTextSearchEnabled="False" />
                    <Button Grid.Column="1"
                            Content="添加"
                            MinHeight="34"
                            Padding="9,4"
                            Margin="6,0,0,0"
                            Click="AddCategory_Click" />
                    <Button Grid.Column="2"
                            Content="删除"
                            MinHeight="34"
                            Padding="9,4"
                            Margin="6,0,0,0"
                            Click="DeleteCategory_Click" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="标签" Margin="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="TagsBox" ToolTip="多个标签用逗号分隔" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="注释" Margin="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="NoteBox"
                         Height="82"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="92" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Content="保存错题"
                    Width="112"
                    Style="{StaticResource PrimaryButton}"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
