<Window x:Class="MajsoulReview.Windows.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择截图区域"
        Icon="/MajsoulReview;component/Assets/MajsoulReview.ico"
        Width="1080" Height="760"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="框选要保存的牌桌区域" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="按住鼠标左键拖动。该区域会按窗口比例保存，并用于下一张答案截图。" />
        </StackPanel>

        <Border Grid.Row="2" Background="#111716" BorderBrush="#2E3835" BorderThickness="1">
            <Grid x:Name="ImageHost"
                  ClipToBounds="True"
                  MouseLeftButtonDown="ImageHost_MouseLeftButtonDown"
                  MouseMove="ImageHost_MouseMove"
                  MouseLeftButtonUp="ImageHost_MouseLeftButtonUp">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
                <Canvas x:Name="Overlay" IsHitTestVisible="False">
                    <Rectangle x:Name="SelectionRectangle"
                               Visibility="Collapsed"
                               Stroke="#35D09F"
                               StrokeThickness="3"
                               Fill="#2835D09F" />
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <TextBlock x:Name="SelectionText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="尚未选择区域" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="88" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton"
                        Content="使用此区域"
                        Width="118"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}"
                        Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
