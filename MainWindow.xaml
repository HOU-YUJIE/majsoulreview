<Window x:Class="MajsoulReview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="雀魂错题集"
        Icon="/MajsoulReview;component/Assets/MajsoulReview.ico"
        Width="1180" Height="760"
        MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Background="#1D2528" Padding="22,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="雀魂错题集" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="两次截图，一道错题" Foreground="#AEBAB6" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="重新选择区域" Margin="0,0,10,0" Click="ResetCrop_Click" />
                    <Button Content="开始新错题" Style="{StaticResource PrimaryButton}" Click="StartCapture_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox"
                             ToolTip="搜索分类、标签或注释"
                             TextChanged="SearchBox_TextChanged" />

                    <ListBox x:Name="CardsList"
                             Grid.Row="2"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="CardsList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="#F4F6F5" />
                                <Setter Property="BorderBrush" Value="#E2E7E5" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    MinHeight="82"
                                                    Padding="12"
                                                    Margin="0,0,0,7"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E7F3EF" />
                                                    <Setter Property="BorderBrush" Value="#147D64" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#8EA39B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplayMeta}" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Tags}" Foreground="#147D64" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayStats}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="截图快捷键" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HotkeyInput"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="点击后直接按下任意键或组合键"
                                     GotKeyboardFocus="HotkeyInput_GotKeyboardFocus"
                                     LostKeyboardFocus="HotkeyInput_LostKeyboardFocus"
                                     PreviewKeyDown="HotkeyInput_PreviewKeyDown" />
                            <Button Grid.Column="2"
                                    Content="应用"
                                    Padding="12,4"
                                    MinHeight="34"
                                    Click="ApplyHotkey_Click" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="点击输入框，然后按下新的快捷键" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource LineBrush}" />

            <Grid Grid.Column="2" Margin="22">
                <Grid x:Name="EmptyState">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="还没有选中错题" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,9,0,0"
                                   Text="在雀魂复盘的错误一打界面按快捷键，再切换到正确一打并按第二次。"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <Button Content="开始捕获" Margin="0,18,0,0" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="StartCapture_Click" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="CardView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="CardTitle" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="CardMeta" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="编辑" Margin="0,0,8,0" Click="EditCard_Click" />
                            <Button Content="删除" Foreground="#A5362C" Click="DeleteCard_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#101615" BorderBrush="#DCE2DF" BorderThickness="1">
                        <Grid>
                            <Image x:Name="CardImage" Stretch="Uniform" Margin="10" />
                            <Border x:Name="ImageBadge" Background="#D9A52B" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="11,6">
                                <TextBlock x:Name="ImageBadgeText" Text="错误一打" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CardTags" Foreground="#147D64" FontWeight="SemiBold" />
                            <TextBlock x:Name="CardReviewStats" Margin="0,6,20,0" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="CardNote"
                                       Margin="0,6,20,0"
                                       TextWrapping="Wrap"
                                       MaxHeight="70"
                                       Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <StackPanel x:Name="ReviewActions"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                <Button x:Name="WrongButton"
                                        Content="这次做错了"
                                        Foreground="#A5362C"
                                        Margin="0,0,8,0"
                                        Click="WrongAnswer_Click" />
                                <Button x:Name="CorrectButton"
                                        Content="这次做对了"
                                        Background="#E7F3EF"
                                        BorderBrush="#147D64"
                                        Foreground="#126951"
                                        Click="CorrectAnswer_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="上一题" Margin="0,0,8,0" Click="PreviousCard_Click" />
                                <Button x:Name="RevealButton" Content="显示正确一打" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="Reveal_Click" />
                                <Button Content="下一题" Click="NextCard_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#E9EDEA" BorderBrush="#D7DEDA" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="导出备份" MinHeight="28" Padding="9,3" Margin="0,0,8,0" Click="Export_Click" />
                    <Button Content="数据目录" MinHeight="28" Padding="9,3" Click="OpenData_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
